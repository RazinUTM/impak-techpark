/* IMPAK – Technovation Park — live-session backend (Google Apps Script, V8), bound to a private Google Sheet.
 *
 * Deploy as a web app: Execute as "Me", access "Anyone" (participants are outsiders; identity is name + e-mail,
 * verified by an e-mailed code when the room's tier is "code"). The game engine (engine.gs, a verbatim copy of
 * src/engine.js) runs here too, so official results are a server-side replay of each team's order log.
 *
 * Sheet tabs (created by setup(), or on first use): rooms, players, orders, decisions, results, users, codes, log,
 * feedback (the public trial's feedback card), runs (anonymous practice-game statistics).
 * Script properties: GM_PIN (facilitator PIN), SECRET (token signing key; generated by setup()).
 * API: GET  ?op=ping | ?op=room&room=CODE | ?op=state&room=CODE[&token=..]
 *      POST JSON {op: join|sendCode|order|decide|report|gm|feedback|run, ...}   (text/plain body, no preflight)
 */

var TABS = {
  rooms: ['code', 'game', 'pins', 'tier', 'gmEmail', 'status', 'createdAt', 'updatedAt'],
  players: ['room', 'team', 'name', 'email', 'org', 'verified', 'joinedAt'],
  orders: ['room', 'team', 'seq', 't', 'type', 'order', 'receivedAt', 'tServer'],
  decisions: ['room', 'team', 'eid', 'opt', 'receivedAt'],
  results: ['room', 'team', 'reported', 'official', 'medal', 'A', 'B1', 'B2', 'B3', 'C', 'D', 'E', 'flag', 'orders', 'at'],
  users: ['email', 'role', 'name', 'active'],
  codes: ['email', 'code', 'expires', 'used', 'sentAt'],
  log: ['at', 'op', 'room', 'team', 'detail'],
  feedback: ['at', 'gid', 'mode', 'level', 'medal', 'total', 'month', 'fun', 'learn', 'good', 'bad', 'email', 'team', 'room', 'lang', 'version', 'ua', 'width'],
  runs: ['at', 'gid', 'mode', 'level', 'seed', 'site', 'status', 'month', 'why', 'medal', 'total', 'durMin', 'lang', 'version', 'width'],
};
var TRIAL_MAX_ROWS = 20000, TXT_MAX = 600;   // the public trial's sheets stop accepting rows past this (spam ceiling)
var CODE_TTL_MS = 10 * 60 * 1000, CODE_MAX_PER_HOUR = 5, ORDER_TOLERANCE = 0.5;   // months

/* ------------------------------------------------------------------ setup (run once from the editor) */
function setup() {
  var ss = SpreadsheetApp.getActive();
  Object.keys(TABS).forEach(function (name) {
    var sh = ss.getSheetByName(name) || ss.insertSheet(name);
    if (sh.getLastRow() === 0) { sh.appendRow(TABS[name]); sh.setFrozenRows(1); }
  });
  var props = PropertiesService.getScriptProperties();
  if (!props.getProperty('SECRET')) props.setProperty('SECRET', Utilities.getUuid() + Utilities.getUuid());
  if (!props.getProperty('GM_PIN')) props.setProperty('GM_PIN', String(100000 + Math.floor(Math.random() * 900000)));
  var users = ss.getSheetByName('users');
  if (users.getLastRow() === 1) users.appendRow([Session.getEffectiveUser().getEmail(), 'gm', 'Owner', 'TRUE']);
  Logger.log('GM_PIN = ' + props.getProperty('GM_PIN'));
}

/* ------------------------------------------------------------------ HTTP */
function doGet(e) { return out(handle(e && e.parameter ? e.parameter : {})); }
function doPost(e) {
  var p = {};
  try { p = JSON.parse(e.postData.contents); } catch (err) { return out({ error: 'json' }); }
  return out(handle(p));
}
function out(obj) { return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON); }
function handle(p) {
  try {
    switch (p.op) {
      case 'ping': return { ok: true, serverTime: Date.now() };
      case 'room': return roomInfo(p);
      case 'state': return state(p);
      case 'join': return join(p);
      case 'sendCode': return sendCode(p);
      case 'order': return order(p);
      case 'decide': return decide(p);
      case 'report': return report(p);
      case 'gm': return gm(p);
      case 'feedback': return feedback(p);
      case 'run': return runRecord(p);
      default: return { error: 'op' };
    }
  } catch (err) { return { error: 'server', message: String(err && err.message || err) }; }
}

/* ------------------------------------------------------------------ sheets, cache, lock */
function sheet(name) {
  var ss = SpreadsheetApp.getActive(), sh = ss.getSheetByName(name);
  if (!sh && TABS[name]) { sh = ss.insertSheet(name); sh.appendRow(TABS[name]); sh.setFrozenRows(1); }   // tabs added after setup() ran
  return sh;
}
function rows(name) { var sh = sheet(name), n = sh.getLastRow(); if (n < 2) return []; var head = TABS[name]; return sh.getRange(2, 1, n - 1, head.length).getValues().map(function (r, i) { var o = { _row: i + 2 }; head.forEach(function (h, k) { o[h] = r[k]; }); return o; }); }
function append(name, obj) { sheet(name).appendRow(TABS[name].map(function (h) { return obj[h] === undefined ? '' : obj[h]; })); }
function cache() { return CacheService.getScriptCache(); }
function withLock(fn) { var lock = LockService.getScriptLock(); lock.waitLock(20000); try { return fn(); } finally { lock.releaseLock(); } }
/* too many wrong PINs for one room (or one GM e-mail) lock that key for a while; Apps Script sees no client address, so the key is the target */
var PIN_MAX = 25, PIN_LOCK_S = 900;
function tooManyTries(key) { var n = Number(cache().get('tries:' + key) || 0); if (n >= PIN_MAX) return true; cache().put('tries:' + key, String(n + 1), PIN_LOCK_S); return false; }
function log(op, room, team, detail) { try { append('log', { at: new Date(), op: op, room: room || '', team: team || '', detail: detail || '' }); } catch (e) { /* ignore */ } }

/* ------------------------------------------------------------------ rooms */
function roomRow(code) { code = String(code || '').toUpperCase(); if (!code) return null; var r = rows('rooms').filter(function (x) { return x.code === code; }); return r.length ? r[r.length - 1] : null; }
function loadRoom(code) {
  code = String(code || '').toUpperCase();
  var c = cache().get('room:' + code);
  if (c) return JSON.parse(c);
  var r = roomRow(code); if (!r) return null;
  var room = { code: code, game: JSON.parse(r.game || 'null'), pins: JSON.parse(r.pins || '{}'), tier: r.tier || 'open', gmEmail: r.gmEmail, status: r.status, _row: r._row };
  cache().put('room:' + code, JSON.stringify(room), 21600);
  return room;
}
function saveRoom(room) {
  var sh = sheet('rooms'), now = new Date();
  var vals = [room.code, JSON.stringify(room.game), JSON.stringify(room.pins), room.tier || 'open', room.gmEmail || '', (room.game && room.game.status) || 'setup', room.createdAt || now, now];
  if (room._row) sh.getRange(room._row, 1, 1, vals.length).setValues([vals]); else { sh.appendRow(vals); room._row = sh.getLastRow(); }
  cache().put('room:' + room.code, JSON.stringify(room), 21600);
}
function newCode() { var A = 'ABCDEFGHJKLMNPQRSTUVWXYZ', c = ''; for (var i = 0; i < 4; i++) c += A.charAt(Math.floor(Math.random() * A.length)); return roomRow(c) ? newCode() : c; }
function newPin(len) { var s = ''; for (var i = 0; i < len; i++) s += Math.floor(Math.random() * 10); return s; }
function roomInfo(p) {
  var room = loadRoom(p.room); if (!room || !room.game) return { error: 'room' };
  return { room: room.code, level: room.game.level, status: room.game.status, teams: room.game.teams.map(function (t) { return { id: t.id, name: t.name }; }), tier: room.tier, serverTime: Date.now() };
}

/* ------------------------------------------------------------------ orders and decisions (cached per room) */
function ordersOf(code) {
  var c = cache().get('orders:' + code); if (c) return JSON.parse(c);
  var o = {}; rows('orders').forEach(function (r) { if (r.room !== code) return; (o[r.team] = o[r.team] || []).push(JSON.parse(r.order)); });
  cache().put('orders:' + code, JSON.stringify(o), 21600); return o;
}
function decisionsOf(code) {
  var c = cache().get('dec:' + code); if (c) return JSON.parse(c);
  var d = {}; rows('decisions').forEach(function (r) { if (r.room !== code) return; (d[r.eid] = d[r.eid] || {})[r.team] = JSON.parse(r.opt); });
  cache().put('dec:' + code, JSON.stringify(d), 21600); return d;
}

/* ------------------------------------------------------------------ tokens */
function sign(s) { var sig = Utilities.computeHmacSha256Signature(s, PropertiesService.getScriptProperties().getProperty('SECRET')); return Utilities.base64EncodeWebSafe(sig).replace(/=+$/, ''); }
function makeToken(room, team, role) { var body = Utilities.base64EncodeWebSafe(JSON.stringify({ room: room, team: team, role: role, exp: Date.now() + 36 * 3600 * 1000 })).replace(/=+$/, ''); return body + '.' + sign(body); }
function readToken(tok) {
  if (!tok || tok.indexOf('.') < 0) return null; var parts = tok.split('.'); if (sign(parts[0]) !== parts[1]) return null;
  var o = JSON.parse(Utilities.newBlob(Utilities.base64DecodeWebSafe(parts[0])).getDataAsString()); return o.exp > Date.now() ? o : null;
}
function auth(p, role) { var t = readToken(p.token); if (!t) return null; if (role && t.role !== role) return null; if (p.room && t.room && String(p.room).toUpperCase() !== t.room) return null; return t; }

/* ------------------------------------------------------------------ clock (mirrors clockOf in the game core) */
/* The clock stops at every pause point (deal, checkpoint, forecast, downturn, final bell) until the Game Master
   closes it; the browser computes this in clockOf() and lets teams place orders during a checkpoint. The server
   must stop at the same points, or it judges such orders "late" (seen 5 Nov 2026: order at 24 vs server 27.27). */
var SCN = {};
function scenarioOf(g) { var k = g.seed + '|' + (g.level || 'lestari'); return SCN[k] || (SCN[k] = PB.makeScenario(g.seed, g.level || 'lestari')); }
function pausePointsSrv(sc) {
  var lv = sc.lv, p = sc.events.map(function (e) { return { id: e.id, t: e.t }; });
  if (sc.months > lv.fundEnd) p.push({ id: 'cp24', t: lv.fundEnd });
  if (lv.zones.indexOf('H') >= 0 && sc.months > 36) p.push({ id: 'cp36', t: 36 });
  if (sc.downturn.forecastAt) p.push({ id: 'fc', t: sc.downturn.forecastAt - 1 + 0.02 });
  if (!sc.downturn.none && sc.downturn.start <= sc.months) p.push({ id: 'dt', t: sc.downturn.start - 1 + 0.02 });
  p.push({ id: 'end', t: sc.months });
  return p.sort(function (a, b) { return a.t - b.t; });
}
function serverT(g) {
  if (!g || g.status === 'setup') return 0;
  var sc = scenarioOf(g);
  if (g.status === 'ended') return sc.months;
  var T = (g.accMs + (g.status === 'running' ? Math.max(0, Date.now() - g.startedAt) : 0)) / g.msPerMonth;
  var closed = g.closed || {}, pts = pausePointsSrv(sc);
  for (var i = 0; i < pts.length; i++) if (!closed[pts[i].id]) { if (T >= pts[i].t - 1e-9) T = pts[i].t; break; }
  return Math.min(T, sc.months);
}

/* ------------------------------------------------------------------ state (polled by every screen) */
function state(p) {
  var room = loadRoom(p.room); if (!room || !room.game) return { error: 'room' };
  var tok = readToken(p.token), g = JSON.parse(JSON.stringify(room.game));
  if (tok && tok.role === 'gm') g.pins = room.pins; else delete g.pins;
  return { game: g, orders: ordersOf(room.code), decisions: decisionsOf(room.code), serverTime: Date.now() };
}

/* ------------------------------------------------------------------ join and e-mail codes */
function join(p) {
  var room = loadRoom(p.room); if (!room || !room.game || room.game.status === 'ended') return { error: 'room' };
  if (!p.name || !p.email || !p.pin) return { error: 'fields' };
  if (tooManyTries('join:' + room.code)) return { error: 'pin', message: 'too many attempts; try again later' };
  var team = null; Object.keys(room.pins).forEach(function (id) { if (String(room.pins[id]) === String(p.pin).trim()) team = id; });
  if (!team) return { error: 'pin' };
  cache().remove('tries:join:' + room.code);
  var verified = false;
  if (room.tier === 'code') { if (!checkCode(p.email, p.code)) return { error: 'code' }; verified = true; }
  append('players', { room: room.code, team: team, name: String(p.name).slice(0, 80), email: String(p.email).toLowerCase().slice(0, 120), org: String(p.org || '').slice(0, 120), verified: verified, joinedAt: new Date() });
  log('join', room.code, team, p.email);
  return { room: room.code, team: team, token: makeToken(room.code, team, 'team'), game: state({ room: room.code }).game, serverTime: Date.now() };
}
function sendCode(p) {
  var email = String(p.email || '').trim().toLowerCase(); if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) return { error: 'fields' };
  var recent = rows('codes').filter(function (r) { return r.email === email && (Date.now() - new Date(r.sentAt).getTime()) < 3600 * 1000; });
  if (recent.length >= CODE_MAX_PER_HOUR) return { error: 'code', message: 'too many codes; try later' };
  var code = newPin(6);
  append('codes', { email: email, code: code, expires: new Date(Date.now() + CODE_TTL_MS), used: false, sentAt: new Date() });
  MailApp.sendEmail({ to: email, subject: 'IMPAK – Technovation Park — your code', body: 'Your sign-in code is ' + code + '. It is valid for 10 minutes.\n\nIf you did not ask for it, ignore this e-mail.' });
  return { ok: true };
}
function checkCode(email, code) {
  email = String(email || '').trim().toLowerCase(); code = String(code || '').trim();
  if (!code) return false;
  var sh = sheet('codes'), all = rows('codes'), ok = false;
  for (var i = all.length - 1; i >= 0; i--) {
    var r = all[i]; if (r.email !== email) continue;
    if (String(r.used) === 'true' || r.used === true) continue;
    if (new Date(r.expires).getTime() < Date.now()) continue;
    if (String(r.code) === code) { sh.getRange(r._row, 4).setValue(true); ok = true; break; }
  }
  return ok;
}

/* ------------------------------------------------------------------ team writes */
function order(p) {
  var tok = auth(p, 'team'); if (!tok) return { error: 'auth' };
  var room = loadRoom(tok.room); if (!room || !room.game) return { error: 'room' };
  var g = room.game, o = p.order; if (!o || typeof o !== 'object') return { error: 'fields' };
  if (g.status === 'setup' || g.status === 'ended') return { error: 'closed' };
  var T = serverT(g); if (typeof o.t !== 'number' || o.t > T + 0.05 || o.t < T - ORDER_TOLERANCE) return { error: 'late', message: 'order time ' + o.t + ' vs server ' + T.toFixed(2) };
  withLock(function () {
    append('orders', { room: room.code, team: tok.team, seq: o.seq || 0, t: o.t, type: o.type || '', order: JSON.stringify(o), receivedAt: new Date(), tServer: T });
    var all = ordersOf(room.code); (all[tok.team] = all[tok.team] || []).push(o); cache().put('orders:' + room.code, JSON.stringify(all), 21600);
  });
  return { ok: true, serverTime: Date.now() };
}
function decide(p) {
  var tok = auth(p, 'team'); if (!tok) return { error: 'auth' };
  var room = loadRoom(tok.room); if (!room || !room.game) return { error: 'room' };
  var g = room.game; if (g.closed && g.closed[p.eid]) return { error: 'closed' };
  withLock(function () {
    append('decisions', { room: room.code, team: tok.team, eid: String(p.eid), opt: JSON.stringify(p.opt), receivedAt: new Date() });
    var d = decisionsOf(room.code); (d[p.eid] = d[p.eid] || {})[tok.team] = p.opt; cache().put('dec:' + room.code, JSON.stringify(d), 21600);
  });
  return { ok: true, serverTime: Date.now() };
}
function report(p) {
  var tok = auth(p, 'team'); if (!tok) return { error: 'auth' };
  var room = loadRoom(tok.room); if (!room || !room.game) return { error: 'room' };
  var r = replayTeam(room, tok.team);
  var flag = Math.abs((+p.score || 0) - r.total) > 0.05 ? 'mismatch' : 'ok';
  append('results', { room: room.code, team: tok.team, reported: +p.score || 0, official: r.total, medal: r.medal, A: r.A, B1: r.B1, B2: r.B2, B3: r.B3, C: r.C, D: r.D, E: r.E, flag: flag, orders: (ordersOf(room.code)[tok.team] || []).length, at: new Date() });
  log('report', room.code, tok.team, flag);
  return { ok: true, official: r.total, medal: r.medal, flag: flag };
}

/* ------------------------------------------------------------------ server-side replay with the shared engine */
function replayTeam(room, teamId) {
  var g = room.game, sc = PB.makeScenario(g.seed, g.level || 'lestari');
  if (g.startCash != null && g.startCash !== sc.lv.startCash) { var lv = {}; for (var k in sc.lv) lv[k] = sc.lv[k]; lv.startCash = g.startCash; sc.lv = lv; }
  var orders = ordersOf(room.code)[teamId] || [], decs = decisionsOf(room.code);
  var dec = {}; Object.keys(g.dec || {}).forEach(function (eid) { dec[eid] = (g.dec[eid] || {})[teamId] || 'L'; });
  Object.keys(decs).forEach(function (eid) { if (dec[eid] === undefined && decs[eid][teamId] != null) dec[eid] = decs[eid][teamId]; });
  var t = PB.replay(sc, teamId, 'priority', orders, dec, g.closed || {}, sc.months);
  var D = sc.lv.score.D > 0 ? ((g.defence || {})[teamId] != null ? g.defence[teamId] : 0) : null;
  var rub = PB.rubric(t, sc, D, sc.months);
  return { total: Math.round(rub.total * 100) / 100, medal: rub.medal, A: rub.A, B1: rub.B1, B2: rub.B2, B3: rub.B3, C: rub.C, D: rub.D, E: rub.E };
}

/* ------------------------------------------------------------------ Game Master */
function gm(p) {
  if (p.action === 'open') {
    var email = String(p.email || '').trim().toLowerCase();
    var ok = rows('users').some(function (u) { return String(u.email).toLowerCase() === email && (u.active === true || String(u.active).toUpperCase() === 'TRUE'); });
    if (tooManyTries('gm:' + email)) return { error: 'pin', message: 'too many attempts; try again later' };
    if (!ok || String(p.gmpin) !== PropertiesService.getScriptProperties().getProperty('GM_PIN')) return { error: 'pin' };
    cache().remove('tries:gm:' + email);
    var code = String(p.room || '').toUpperCase(), room = code ? loadRoom(code) : null;
    if (code && !room) return { error: 'room' };
    log('gm-open', code, '', email);
    return { room: room ? room.code : '', token: makeToken(room ? room.code : '', '', 'gm'), serverTime: Date.now() };
  }
  var tok = readToken(p.token); if (!tok || tok.role !== 'gm') return { error: 'auth' };
  if (p.action === 'set') {
    var g = p.game; if (!g || !g.teams) return { error: 'fields' };
    var pins = {}; g.teams.forEach(function (t) { pins[t.id] = newPin(4); });
    var room2 = { code: newCode(), game: g, pins: pins, tier: p.tier || 'open', gmEmail: '', createdAt: new Date() };
    withLock(function () { saveRoom(room2); cache().remove('orders:' + room2.code); cache().remove('dec:' + room2.code); });
    log('gm-set', room2.code, '', g.level);
    var gg = JSON.parse(JSON.stringify(g)); gg.pins = pins;
    return { room: room2.code, game: gg, token: makeToken(room2.code, '', 'gm'), serverTime: Date.now() };
  }
  var room3 = loadRoom(p.room || tok.room); if (!room3 || !room3.game) return { error: 'room' };
  if (p.action === 'update') {
    withLock(function () { room3 = loadRoom(room3.code); room3.game = deepMerge(room3.game, p.patch || {}); saveRoom(room3); });
    return { ok: true, serverTime: Date.now() };
  }
  if (p.action === 'tier') { room3.tier = p.tier === 'code' ? 'code' : 'open'; saveRoom(room3); return { ok: true }; }
  if (p.action === 'replay') {
    var outRows = room3.game.teams.map(function (t) { var r = replayTeam(room3, t.id); append('results', { room: room3.code, team: t.id, reported: '', official: r.total, medal: r.medal, A: r.A, B1: r.B1, B2: r.B2, B3: r.B3, C: r.C, D: r.D, E: r.E, flag: 'replay', orders: (ordersOf(room3.code)[t.id] || []).length, at: new Date() }); return { team: t.id, name: t.name, official: r.total, medal: r.medal }; });
    return { ok: true, results: outRows };
  }
  if (p.action === 'results') {
    var res = rows('results').filter(function (r) { return r.room === room3.code; });
    return { ok: true, results: res.map(function (r) { delete r._row; return r; }) };
  }
  return { error: 'action' };
}
function deepMerge(a, b) { a = a || {}; for (var k in b) { if (b[k] && typeof b[k] === 'object' && !Array.isArray(b[k])) { a[k] = a[k] && typeof a[k] === 'object' ? a[k] : {}; deepMerge(a[k], b[k]); } else a[k] = b[k]; } return a; }

/* ------------------------------------------------------------------ housekeeping (run by hand or on a time trigger) */
function purgeCodes() { var sh = sheet('codes'), all = rows('codes'); for (var i = all.length - 1; i >= 0; i--) if (new Date(all[i].expires).getTime() < Date.now() - 86400000) sh.deleteRow(all[i]._row); }

/* ------------------------------------------------------------------ the public trial: feedback card and anonymous run statistics */
function clip(v, n) { return String(v == null ? '' : v).slice(0, n); }
function num(v, lo, hi) { if (v === '' || v == null) return ''; var n = Number(v); if (!isFinite(n)) return ''; return Math.max(lo, Math.min(hi, n)); }
function feedback(p) {
  if (p.hp) return { ok: true };                                    // honeypot field filled in: a bot; pretend to accept
  var sh = sheet('feedback'); if (sh.getLastRow() > TRIAL_MAX_ROWS) return { error: 'full' };
  var fun = num(p.fun, 1, 5), learn = num(p.learn, 1, 5), good = clip(p.good, TXT_MAX).trim(), bad = clip(p.bad, TXT_MAX).trim();
  if (fun === '' && learn === '' && !good && !bad) return { error: 'fields' };
  var email = clip(p.email, 120).trim().toLowerCase(); if (email && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) email = '';
  var k = 'fb:' + clip(p.gid, 40) + ':' + clip(p.team, 40); if (p.gid && cache().get(k)) return { ok: true, dup: true };
  append('feedback', { at: new Date(), gid: clip(p.gid, 40), mode: clip(p.mode, 10), level: clip(p.level, 10), medal: clip(p.medal, 10), total: num(p.total, 0, 100), month: num(p.month, 0, 120),
    fun: fun, learn: learn, good: good, bad: bad, email: email, team: clip(p.team, 40), room: clip(p.room, 6).toUpperCase(), lang: clip(p.lang, 5), version: clip(p.version, 20), ua: clip(p.ua, 20), width: num(p.width, 0, 20000) });
  if (p.gid) cache().put(k, '1', 21600);
  return { ok: true };
}
function runRecord(p) {
  var status = clip(p.status, 10); if (['ended', 'early', 'left', 'deleted'].indexOf(status) < 0 || !p.gid) return { error: 'fields' };
  var sh = sheet('runs'); if (sh.getLastRow() > TRIAL_MAX_ROWS) return { error: 'full' };
  var k = 'run:' + clip(p.gid, 40) + ':' + status; if (cache().get(k)) return { ok: true, dup: true };
  append('runs', { at: new Date(), gid: clip(p.gid, 40), mode: clip(p.mode, 10), level: clip(p.level, 10), seed: clip(p.seed, 20), site: clip(p.site, 12), status: status, month: num(p.month, 0, 120),
    why: clip(p.why, 20), medal: clip(p.medal, 10), total: num(p.total, 0, 100), durMin: num(p.durMin, 0, 100000), lang: clip(p.lang, 5), version: clip(p.version, 20), width: num(p.width, 0, 20000) });
  cache().put(k, '1', 21600);
